{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChunkTrainer",
  "version": "2.1.0",
  "identifier": "com.abdo.chunktrainer",
  "build": {
    "frontendDist": "../dist-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "دفتر الشانكس | ChunkTrainer",
        "width": 1340,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#eaf0f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
